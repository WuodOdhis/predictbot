{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "predictbot-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ARENA", "class_name": "ArenaWorker" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ArenaWorker"] }],
  "vars": {
    "BOT_RPC_URL": "https://rpc.bohr.life",
    "ARENA_CONTRACT_ADDRESS": "0xcd8da7961c607ad246dfb4a74ba2d07de38df346",
    "GROQ_MODEL_A": "openai/gpt-oss-120b",
    "GROQ_MODEL_B": "openai/gpt-oss-20b",
  },
}
